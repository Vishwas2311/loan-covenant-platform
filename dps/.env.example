# Local development only. Production: DPS_AUTH_MODE=JWT with issuer, audience and JWKS URL.
DPS_DATABASE_URL=sqlite:///./dps.db
DPS_STORAGE_DIR=./storage
DPS_MAX_UPLOAD_MB=50
DPS_AUTH_MODE=DEV_HEADER
# DPS_JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# DPS_JWT_AUDIENCE=api://covenant-dps
# DPS_JWT_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
DPS_CORE_BASE_URL=http://localhost:9310
DPS_CORE_DATA_SOURCE_ID=d5000000-0000-0000-0000-000000000d95
# Advisory AI (optional). Example: azure/<deployment> with AZURE_API_KEY, AZURE_API_BASE, AZURE_API_VERSION.
DPS_AI_MODEL=
# Longest wait for one model answer, in seconds; a slower answer falls back to the rules answer.
# DPS_AI_TIMEOUT_SECONDS=60
