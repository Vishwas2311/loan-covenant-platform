# Copy to deploy/.env (git-ignored) and replace every value. Never commit deploy/.env.
MSSQL_SA_PASSWORD=ChangeMe-Strong-Password-1
COVENANT_SUPPORT_TOKEN=change-me-support-token
DEMO_READER_PASSWORD=change-me-Demo1

# Only for real local testing (docker-compose.real.yml, docs/local-real-testing.md).
# Generate the four Keycloak values with the command in that guide.
KC_ADMIN_PASSWORD=change-me
KC_DEMO_PASSWORD=change-me
CORE_SERVICE_CLIENT_SECRET=change-me
DPS_SERVICE_CLIENT_SECRET=change-me
# Azure OpenAI for the AI features. Leave the key empty to run them on rules.
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_DEPLOYMENT=<deployment-name>
AZURE_API_VERSION=2025-04-01-preview
